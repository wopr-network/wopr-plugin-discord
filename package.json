{
  "name": "wopr-plugin-discord",
  "version": "2.11.0",
  "description": "Discord bot integration for WOPR - Enables AI conversations in Discord channels",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "biome check --config-path=. src/",
    "lint:fix": "biome check --config-path=. --fix src/",
    "format": "biome format --config-path=. --write src/",
    "check": "biome check --config-path=. src/ && tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "wopr",
    "plugin",
    "discord",
    "bot",
    "ai"
  ],
  "author": "WOPR",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.19.11",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "undici": "6.23.0"
  }
}
