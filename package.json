{
  "name": "wopr-plugin-discord",
  "version": "2.11.0",
  "description": "Discord bot integration for WOPR - Enables AI conversations in Discord channels",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "check": "biome check --fix src/ && tsc --noEmit"
  },
  "keywords": [
    "wopr",
    "plugin",
    "discord",
    "bot",
    "ai"
  ],
  "author": "WOPR",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
